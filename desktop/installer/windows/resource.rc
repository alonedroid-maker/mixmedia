#include <winver.h>

#ifndef APP_VER_CSV
#define APP_VER_CSV 1,0,0,0
#endif

#ifndef APP_VER_STR
#define APP_VER_STR "1.0.0"
#endif

1 ICON "mediax.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VER_CSV
 PRODUCTVERSION APP_VER_CSV
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "MediaX"
            VALUE "FileDescription", "MediaX Desktop (Windows 7 - Windows 11+)"
            VALUE "FileVersion", APP_VER_STR
            VALUE "InternalName", "MediaX"
            VALUE "OriginalFilename", "MediaX.exe"
            VALUE "ProductName", "MediaX"
            VALUE "ProductVersion", APP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
